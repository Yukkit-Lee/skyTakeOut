<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetMealDishMapper">



    <select id="getSeatMealDishById" resultType="com.sky.entity.SetmealDish">

        SELECT * FROM setmeal_dish
        WHERE  dish_id IN
        <foreach collection="idArr" open="(" close=")" item="curDishId" separator=",">
            #{curDishId}
        </foreach>
    </select>
    <select id="getSeatMealDishBySetmealId" resultType="com.sky.entity.SetmealDish">
        SELECT * FROM setmeal_dish
        WHERE setmeal_id = #{id}
    </select>


    <insert id="insertSetMealDish">
        INSERT INTO setmeal_dish (setmeal_id, dish_id, name, price, copies) VALUES
        <foreach collection="setmealDishes" separator="," item="setmealdish">
            (#{setmealdish.setmealId},#{setmealdish.dishId},#{setmealdish.name},#{setmealdish.price},#{setmealdish.copies})
        </foreach>
    </insert>


    <delete id="deleteInfoBySetmealId">
        DELETE FROM setmeal_dish
        WHERE setmeal_id = #{setmealId}
    </delete>
    <delete id="deleteSetmealByIds">
        DELETE FROM setmeal_dish
        WHERE setmeal_id IN
        <foreach collection="setmealIdArr" item="setmealId" separator="," close=")"
                 open="(">
            #{setmealId}
        </foreach>
    </delete>
</mapper>