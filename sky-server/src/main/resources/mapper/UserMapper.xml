<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.UserMapper">

    <insert id="insertNewUser" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO user (openid, create_time,name,phone,sex,id_number,avatar)
        VALUES (#{openid}, #{createTime},#{name},#{phone},#{sex},#{idNumber},#{avatar})
    </insert>
</mapper>